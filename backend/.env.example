# ==============================================================================
# SchemeSaathi Environment Configuration
# ==============================================================================

# Anthropic Claude API Key (Required for RAG response generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Multilingual Embedding Model (Supports English, Tamil, and 50+ languages)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Storage Directories
PDF_STORAGE_DIR=data/raw_pdfs
FAISS_INDEX_DIR=data/vector_store

# MongoDB Configuration for Chat History & Sessions
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=schemesaathi

# RAG Retrieval Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
