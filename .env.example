# ==============================================================================
# SchemeSaathi Environment Configuration
# ==============================================================================

# Anthropic Claude API Key (Required for answer generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# MongoDB Connection URI (for chat history and session persistence)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=schemesaathi

# Multilingual Sentence Transformer Model (supports English, Tamil, and 50+ languages)
EMBED_MODEL=intfloat/multilingual-e5-small

# RAG Search Configuration
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Storage Paths (relative to root or absolute)
RAW_DATA_DIR=data/raw
INDEX_DATA_DIR=data/index

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
